[Unit]
Description=XMTPS Decoder Service

[Service]
Type=simple
PIDFile=/data1/alamo/var/lock/xmtps.pid
User=argo
Group=floatgroup
Restart=always
RestartSec=30
TimeoutStopSec=300
StandardOutput=null
StandardError=null
ExecStart=/data1/alamo/bin/xmtps -v --config /data1/alamo/etc/xmtps.cfg --daemon --pid-file /data1/alamo/var/lock/xmtps.pid

[Install]
WantedBy=multi-user.target
