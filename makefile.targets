# Included by Debug/makefile and Release/makefile (which are generated by Eclipse CDT).
#
# The build number and build date/time reach the code as -D compiler flags, and make does not
# rebuild an object when only a flag's value changes. The objects that print them (the version
# splash, `xmtps --version`, and the listing, RAW and PHY file headers) therefore depend on the
# build number file, which the pre-commit hook increments with each commit.

src/config/LocalConfiguration.o src/data/XFloat.o src/data/XFloatDiveData.o src/data/XFloatMailMessage.o: ../build/buildNo.txt
